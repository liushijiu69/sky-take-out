<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志文件根目录 -->
    <property name="LOG_HOME" value="./logs"/>
    <!-- 日志文件名 -->
    <property name="LOG_FILE" value="sky-take-out"/>
    <!-- 日志保留天数 -->
    <property name="MAX_HISTORY" value="30"/>
    <!-- 单文件最大大小 -->
    <property name="MAX_FILE_SIZE" value="50MB"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p ${PID:-} --- [%15.15t] %-40.40logger{39} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出（滚动策略：按大小切分，日期归档） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p ${PID:-} --- [%t] %-40.40logger{39} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 日志级别配置 -->
    <logger name="com.sky.mapper" level="DEBUG"/>
    <logger name="com.sky.service" level="INFO"/>
    <logger name="com.sky.controller" level="INFO"/>

    <!-- Spring 框架日志降级 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.redisson" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
